# Copy to .env next to docker-compose.yaml and fill in. Never commit .env.
#
# Everything here is optional: with no integrations configured the downloader
# behaves exactly as it always did, and finished files simply stay in the
# completed folder.
#
# Values set here become real environment variables in the container and always
# win over anything stored in /config/.env, so this file is the source of truth
# for a Docker deployment.


# ==============================
# Sonarr
# ==============================
# Settings -> General -> API Key in Sonarr's own UI.
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# Add series Sonarr does not know yet instead of leaving the file in the
# completed folder. Off by default — creating library entries as a side effect
# of one download is usually not what you want.
SONARR_AUTO_ADD=0
SONARR_ROOT_FOLDER=
SONARR_QUALITY_PROFILE_ID=


# ==============================
# Radarr
# ==============================
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

RADARR_AUTO_ADD=0
RADARR_ROOT_FOLDER=
RADARR_QUALITY_PROFILE_ID=


# ==============================
# Jellyfin
# ==============================
# Dashboard -> Advanced -> API Keys.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
JELLYFIN_SCAN_ENABLED=1


# ==============================
# Path translation
# ==============================
# Sonarr and Radarr resolve the paths we hand them inside their OWN
# filesystem. If they mount the same storage somewhere else, say at /data,
# an unmapped path simply does not exist for them and every import fails with
# a confusing "file not found".
#
# Format: <our path>:<their path>, comma-separated for several.
# Leave empty when every container mounts the storage at the same place.
ANIWORLD_ARR_PATH_MAP=

# How Sonarr/Radarr take the file: move | copy
ANIWORLD_ARR_IMPORT_MODE=move


# ==============================
# REST API
# ==============================
# Lets scripts and monitoring authenticate with the X-Api-Key header instead
# of a login session. Generate one with: openssl rand -hex 32
ANIWORLD_API_KEY=


# ==============================
# Webhooks
# ==============================
# Comma-separated URLs receiving download_started, download_completed,
# download_failed and import_completed.
ANIWORLD_WEBHOOK_URLS=

# Optional. When set, deliveries carry
#   X-AniWorld-Signature: sha256=<hmac of the raw body>
ANIWORLD_WEBHOOK_SECRET=


# ==============================
# Queue tuning
# ==============================
ANIWORLD_MAX_RETRIES=3
ANIWORLD_RETRY_BACKOFF_BASE=60

# Abandon and retry a download that made no progress for this many seconds.
# 0 disables the watchdog.
ANIWORLD_STALL_TIMEOUT=900


# ==============================
# Downloader defaults
# ==============================
# German Dub | English Sub | German Sub | English Dub
ANIWORLD_LANGUAGE=German Dub
ANIWORLD_PROVIDER=VOE
ANIWORLD_PROVIDER_FALLBACK_ORDER=VOE,Vidmoly,Vidoza,Doodstream

# SerienStream origins in failover order. Complete origins are required so
# the HTTP-only direct-IP fallback keeps the correct scheme. Change this in
# Dokploy when domains move; no image rebuild is needed.
ANIWORLD_STO_ENDPOINTS=https://serienstream.to,https://serienstream.cx,http://186.2.175.5

# Web UI language: en | de
ANIWORLD_UI_LANGUAGE=en

# 0 = off, 1 = on
ANIWORLD_DEBUG_MODE=0


# ==============================
# Container health
# ==============================
# The entrypoint exits after repeated failed healthchecks so Docker's restart
# policy can recover the service. Set to 0 only when another supervisor owns
# this behavior.
ANIWORLD_HEALTH_WATCHDOG=1

# Optional file located on the remote media mount. When configured, startup
# and healthchecks fail if the mount disappears instead of writing into an
# empty local mountpoint. Example: /media/.aniworld-storage
ANIWORLD_STORAGE_SENTINEL=


# ==============================
# Web UI authentication
# ==============================
# Strongly recommended if the port is reachable from anything but localhost.
ANIWORLD_WEB_AUTH=0
ANIWORLD_WEB_ADMIN_USER=
ANIWORLD_WEB_ADMIN_PASS=

# Public URL when behind a reverse proxy, e.g. https://aniworld.example.com
ANIWORLD_WEB_BASE_URL=
